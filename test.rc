# rust_calc script: Симуляция свободного падения мяча
g = 9.8;
h0 = 100;

# Создаем ленивый диапазон времени от 0 до 5 секунд с шагом 0.5
t_range = 0..5..0.5;

# Генерируем физический кортеж временных меток
t = tuple(t_range);

# Считаем пройденное расстояние по векторизованной формуле: s = (g * t^2) / 2
s = g * t ** 2 / 2;

# Находим текущую высоту мяча: h = h0 - s
h = h0 - s;

# Логируем результаты времени и высоты
print("Время симуляции (сек):", t);
print("Высота мяча (метров):  ", h);

# Финальная проверка: разбился ли мяч на последней секунде?
# (Берем последний элемент кортежа высоты через условие)
if (h0 - g * 5 ** 2 / 2 == 123) {
	print("Ошибка симуляции")
} else if (h0 - g * 5 ** 2 / 2 <= 0) {
	print("Мяч гарантированно коснулся земли за 5 секунд!")
} else {
	print("Мяч всё еще летит!")
}
